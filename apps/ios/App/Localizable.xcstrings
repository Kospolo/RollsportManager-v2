    "kassenbuch.reverse.intro": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Buchungen im Kassenbuch werden nicht gelöscht. Ein Storno erzeugt eine Gegenbuchung mit umgekehrtem Vorzeichen — die Originalbuchung bleibt sichtbar (GoBD)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cash book entries are never deleted. A reversal creates a counter-entry with the opposite sign — the original entry stays visible (GoBD)."
          }
        }
      }
    },
