    "mahnungen.mail.body1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallo %1$@,\n\nbestimmt ist es nur untergegangen: Die Rechnung %2$@ über %3$@ war am %4$@ fällig. Du kannst den Betrag einfach auf das Vereinskonto überweisen — oder gib uns kurz Bescheid, wenn etwas nicht stimmt.\n\nDanke dir und bis bald in der Halle!\n%5$@ · Kassenwartin RSV Neckarsulm"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi %1$@,\n\nthis has probably just slipped through: invoice %2$@ for %3$@ was due on %4$@. Simply transfer the amount to the club account — or let us know if something looks wrong.\n\nThank you, and see you at the rink!\n%5$@ · treasurer, RSV Neckarsulm"
          }
        }
      }
    },
    "mahnungen.mail.body2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallo %1$@,\n\ntrotz unserer Erinnerung ist die Rechnung %2$@ über %3$@ weiterhin offen (fällig am %4$@). Bitte überweise den Betrag innerhalb der nächsten 14 Tage auf das Vereinskonto.\n\nWenn gerade etwas dazwischengekommen ist: Melde dich einfach — wir finden eine Lösung.\n%5$@ · Kassenwartin RSV Neckarsulm"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi %1$@,\n\ndespite our reminder, invoice %2$@ for %3$@ is still open (due on %4$@). Please transfer the amount to the club account within the next 14 days.\n\nIf life got in the way, just reach out — we will find a solution.\n%5$@ · treasurer, RSV Neckarsulm"
          }
        }
      }
    },
    "mahnungen.mail.body3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallo %1$@,\n\ndies ist die zweite und letzte Mahnung zur Rechnung %2$@ über %3$@ (fällig am %4$@). Bitte gleiche den Betrag innerhalb von 10 Tagen aus — sonst müssen wir den Vorgang an den Vorstand übergeben.\n\nSprich uns gern an, wenn wir gemeinsam eine Lösung finden sollen.\n%5$@ · Kassenwartin RSV Neckarsulm"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi %1$@,\n\nthis is the second and final dunning notice for invoice %2$@ for %3$@ (due on %4$@). Please settle the amount within 10 days — otherwise we have to hand the case over to the board.\n\nTalk to us if you would like to find a solution together.\n%5$@ · treasurer, RSV Neckarsulm"
          }
        }
      }
    },
