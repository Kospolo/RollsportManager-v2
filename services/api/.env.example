# ============================================================================
# RollsportManager v2 API - environment fallback.
#
# IMPORTANT: .env is only the FALLBACK configuration source. Operational
# values are meant to be managed through the admin UI later (user preference:
# "Einstellungen immer ins Admin"). Never put real secrets in this file -
# these are placeholders.
# ============================================================================

# HTTP port of the API. 3021 is the web portal - the API uses 3022.
PORT=3022

# Postgres connection. The API connects with a dedicated role that is a
# member of BOTH `authenticated` and `service_role` (in the local harness:
# the postgres superuser). Per request the API impersonates the caller via
# SET LOCAL ROLE authenticated + request.jwt.claims - see src/db.ts.
DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:55433/rsm2

# --- Auth (Blueprint ADR-E3) -------------------------------------------------
# dev  = HS256 with a shared secret (local only, GoTrue default-style)
# prod = ES256 via the GoTrue JWKS endpoint (asymmetric; private key never
#        leaves the auth container)
AUTH_MODE=dev

# dev mode only - shared HS256 secret (min 32 chars). Placeholder!
AUTH_JWT_SECRET=dev-only-placeholder-secret-please-change

# prod mode only - JWKS URL of GoTrue, e.g.
# https://auth.example.org/auth/v1/.well-known/jwks.json
AUTH_JWKS_URL=

# Optional issuer/audience checks (empty = skip, dev only)
AUTH_ISSUER=
AUTH_AUDIENCE=authenticated

# --- Billing / Webhooks (Blueprint ADR-E6) -----------------------------------
# Stripe webhook signing secret (whsec_...). Placeholder! In prod mode the
# endpoint answers 503 until a real value is configured (admin UI later,
# .env stays the fallback).
STRIPE_WEBHOOK_SECRET=whsec-dev-placeholder

# Exact Authorization header value RevenueCat sends (configure the identical
# value in the RevenueCat dashboard webhook settings). Placeholder!
REVENUECAT_WEBHOOK_AUTH=rc-dev-placeholder-token

# Max accepted age of a Stripe signature timestamp, in seconds
STRIPE_SIGNATURE_TOLERANCE_SECONDS=300
