# RollsportManager v2 — Prod-ENV (Vorlage). Kopiere nach deploy/.env und fuelle
# die Secrets. deploy/.env ist gitignored — niemals committen.
#
# Starke Secrets erzeugen (je einen):
#   openssl rand -base64 48

# --- Datenbank ---
POSTGRES_DB=rsm2
POSTGRES_PASSWORD=            # << starkes Passwort
DB_PORT=55434                 # Host-Port der Prod-DB (nur 127.0.0.1)

# --- API ---
API_PORT=3023                 # Host-Port der API (nur 127.0.0.1; NPM proxyt hierauf)
AUTH_JWT_SECRET=              # << stark! signiert/verifiziert ALLE Zugangstoken
RATE_LIMIT_PEPPER=            # << stark! pseudonymisiert IPs in der Drossel

# Reset-/Verify-Links zeigen auf die WEB-App (sobald deployt).
APP_BASE_URL=https://app.rollsportmanager.de

# SMTP wird NICHT hier gesetzt, sondern in internal.platform_settings (DB) —
# per Betreiber-Admin oder SQL. Werte aus v1 (Strato):
#   host=smtp.strato.de  port=587  user=noreply@rollsportmanager.de
#   from="RollsportManager <noreply@rollsportmanager.de>"  secure=false (STARTTLS)
